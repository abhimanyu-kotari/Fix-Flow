# Environment Configuration
PORT=4000
NODE_ENV=development
DEFAULT_COUNTRY_CODE=IN
JWT_SECRET=dev-secret-fixflow-super-secure-key-2026
DB_PATH=./data/fixflow.db

# SMS Authentication Provider (console | mock | twilio)
SMS_PROVIDER=mock

# Twilio Credentials (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP Policy Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_MAX_PER_HOUR=5
